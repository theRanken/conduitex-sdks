{
    "name": "conduitex/sdk",
    "description": "Official Conduitex PHP SDK",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Conduitex\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Conduitex\\Sdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
